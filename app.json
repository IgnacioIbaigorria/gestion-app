{
  "expo": {
    "name": "Gestión App",
    "slug": "punto-eco-gestion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_gestion.png",
    "scheme": "myapp",
    "splash": {
      "image": "./assets/images/logo_gestion.png",
      "resizeMode": "cover",
      "backgroundColor": "#91b578"
    },
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResources": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo_gestion.png",
        "backgroundColor": "#ffffff",
        "resizeMode": "contain"
      },
      "package": "com.ignacioivan00.puntoecogestion"
    },
    "assetBundlePatterns": [
      "assets/images/*"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResources": true
          }
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4ecc3add-1669-449d-aef2-b6a185bd24cd"
      }
    }
  }
}
